<odoo>

    <record id="view_lot_ledger_summary_tree" model="ir.ui.view">
        <field name="name">lot.ledger.summary.tree</field>
        <field name="model">lot.ledger.summary</field>
        <field name="arch" type="xml">
            <list>
                <field name="product_id" />
                <field name="lot_id" />
                <field name="actual_qty" />
                <field name="remaining_qty" />

                <button name="action_view_moves"
                    type="object"
                    string="Details"
                    icon="fa-bars"
                    class="btn-primary" />

            </list>
        </field>
    </record>

    <record id="view_lot_ledger_summary_search" model="ir.ui.view">
        <field name="name">lot.ledger.summary.search</field>
        <field name="model">lot.ledger.summary</field>
        <field name="type">search</field>
        <field name="arch" type="xml">
            <search>
                <!-- Quick search fields -->
                <field name="lot_id" />
                <field name="product_id" />
                <filter string="Has Remaining"
                    name="has_remaining"
                    domain="[('remaining_qty','>',0)]" />
            </search>
        </field>
    </record>


    <record id="action_lot_ledger_summary" model="ir.actions.act_window">
        <field name="name">Lot Inventory Ledger</field>
        <field name="res_model">lot.ledger.summary</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_lot_ledger_summary_search" />
        <field name="context">{'group_by': ['product_id']}</field>
    </record>

    <menuitem id="menu_lot_ledger_summary"
        name="Lot Ledger"
        parent="stock.menu_warehouse_report"
        action="action_lot_ledger_summary" />
</odoo>